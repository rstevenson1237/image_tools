{
  "name": "game-asset-suite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "check:packages": "npm run typecheck --workspaces",
    "test:packages": "npm test --workspaces",
    "gen:ops": "node packages/artgen-cli/src/gen-bin.ts",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "metrics:baseline": "node scripts/metrics-baseline.mjs",
    "metrics:pool": "node packages/artgen-cli/src/bin.ts metrics pool docs/metrics/pool --out docs/metrics/pool/POOL.md",
    "consumers": "node scripts/artgen-consumer-ci.mjs",
    "intake": "node scripts/artgen-intake.mjs",
    "build:dist": "npm run build -w artgen-dist",
    "pack:libs": "node packages/artgen-dist/pack-libs.mjs lib-dist",
    "accept:ui": "node scripts/artgen-ui-bundle-accept.mjs",
    "accept:images": "node scripts/artgen-image-tools-accept.mjs",
    "accept:release": "node scripts/artgen-release-acceptance.mjs",
    "fixtures:install": "npm run build -w artgen-dist && node scripts/artgen-fixtures.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^26.2.0",
    "artgen-cli": "0.0.0",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "artgen-core": "0.0.0",
    "artgen-imagekit": "0.0.0",
    "artgen-runtime": "1.2.1",
    "comlink": "^4.4.2",
    "fabric": "^7.4.0",
    "fflate": "^0.8.3"
  }
}
